{
  "name": "@uniformdev/component-starter-kit",
  "version": "7.0.2",
  "private": true,
  "engines": {
    "yarn": "please-use-npm",
    "pnpm": "please-use-npm",
    "node": "^22.22.0 || >=24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "cross-env NODE_ENV=production run-s pull:locales pull:dex apply:dex next:build",
    "start": "next start",
    "dev:watch": "cross-env WATCH=true run-s pull:dex apply:dex next:dev",
    "next:dev": "next dev",
    "next:build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "init": "csk-cli init",
    "component:extract": "csk-components extract",
    "component:scaffold": "csk-cli scaffold",
    "pull:dex": "design-extensions-tools pull",
    "apply:dex": "design-extensions-tools apply",
    "push:dex": "design-extensions-tools push",
    "pull:locales": "csk-cli pull -l",
    "pull:content": "uniform sync pull",
    "push:content": "uniform sync push",
    "pull:content:dev": "uniform sync pull --config ./uniform.config.dev.ts",
    "push:content:dev": "uniform sync push --config ./uniform.config.dev.ts",
    "uniform:pull": "csk-cli pull -u",
    "uniform:push": "run-s push:dex push:content",
    "uniform:publish": "uniform context manifest publish"
  },
  "dependencies": {
    "@uniformdev/assets": "^20.86.0",
    "@uniformdev/canvas": "^20.86.0",
    "@uniformdev/csk-cli": "7.0.0",
    "@uniformdev/csk-components": "7.0.0",
    "@uniformdev/design-extensions-tools": "7.0.0",
    "@uniformdev/next-app-router": "^20.86.0",
    "@uniformdev/next-app-router-client": "^20.86.0",
    "@uniformdev/next-app-router-shared": "^20.86.0",
    "js-cookie": "^3.0.8",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uniformdev/cli": "^20.86.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.7",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "undici": "5.28.5",
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
